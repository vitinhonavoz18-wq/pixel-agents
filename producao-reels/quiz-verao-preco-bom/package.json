{
  "name": "quiz-verao-preco-bom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts QuizVerao output/quiz-verao-farmacia-preco-bom.mp4 --codec=h264 --audio-codec=aac --crf=18",
    "preview": "remotion render src/index.ts QuizVerao output/preview-baixa.mp4 --scale=0.4 --codec=h264",
    "cover": "remotion still src/index.ts CapaReels output/capa-reels.png",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validateVideo.ts",
    "voice": "tsx scripts/generateVoice.ts && bash scripts/processVoice.sh",
    "sfx": "python3 scripts/generate_audio_assets.py"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/fonts": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
