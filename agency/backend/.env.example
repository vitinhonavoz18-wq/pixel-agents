# PIXEL AGENCY backend — copy to .env (never commit real values).

# ── Required ───────────────────────────────────────────────────────────────
# Bootstrap admin token (random, >= 32 chars). Used once to create app/bridge tokens.
AGENCY_ADMIN_TOKEN=
# Claude credentials for the Agent SDK. claude.ai subscription login is NOT allowed
# for third-party products: use an Anthropic API key (or Bedrock/Vertex/Foundry).
ANTHROPIC_API_KEY=

# ── GitHub (to clone authorized repositories) ─────────────────────────────
# Fine-grained PAT or GitHub App installation token, read access (write only if
# you want agents to push branches after your approval).
AGENCY_GITHUB_TOKEN=
# Optional allowlist of repository owners: "vitinhonavoz18-wq,minha-org"
AGENCY_ALLOWED_REPO_OWNERS=

# ── Optional ──────────────────────────────────────────────────────────────
PORT=8787
AGENCY_DATA_DIR=./data
# AGENCY_WORKSPACES_DIR=./data/workspaces
AGENCY_DEFAULT_MODEL=claude-opus-5-5
AGENCY_MAX_CONCURRENT_MISSIONS=2
AGENCY_MAX_TURNS=80
# Hard per-mission spend cap enforced by the Agent SDK (USD)
AGENCY_MAX_BUDGET_USD=5
AGENCY_MISSION_TIMEOUT_MIN=45
AGENCY_APPROVAL_TIMEOUT_MIN=30
AGENCY_RATE_LIMIT_PER_MIN=240
# Comma-separated allowed browser origins for the web app (default: any)
AGENCY_CORS_ORIGINS=
# Key used to sign short-lived image URLs (defaults to the admin token)
AGENCY_ASSET_SIGNING_KEY=
# Organization cost report (Admin API key sk-ant-admin…) — optional
ANTHROPIC_ADMIN_KEY=
# Playwright screenshots of the project's own app URL (needs Chromium)
AGENCY_ENABLE_CAPTURE=0
# AGENCY_CHROMIUM_PATH=/usr/bin/chromium
# DEMO mode: simulated, clearly labeled events — never use in production
AGENCY_DEMO_MODE=0
